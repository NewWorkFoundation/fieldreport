# dear[CC] Field Report (Vercel)
# Copy to .env.local for local dev. Set the same keys in the Vercel project.
# Never commit real secrets.

# Field Report intentionally has no database connection. Profile progress is
# sent through the server-only dearCC relay configured below.

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="dearCC Field Report <hello@dearcc.org>"
# RESEND_REPLY_TO_EMAIL=

# Public site URL for unsubscribe links (Vercel production URL or custom domain)
BASE_URL=http://localhost:5173

# Public origin used in emailed report links (defaults to https://fieldreport.dearcc.org on localhost)
# VITE_PUBLIC_SITE_URL=https://fieldreport.dearcc.org

# Canonical dearCC profile completion sync (server-only)
DEARCC_PROFILE_URL=https://dearcc.org
PROFILE_SYNC_SECRET=
# Preview only: dearCC's Vercel Protection Bypass for Automation secret.
DEARCC_VERCEL_BYPASS_SECRET=

# Next checklist step after a completed Field Report.
VITE_GAMEPLAN_URL=https://gameplan.dearcc.org

# Field Report v3 — AOI employer layer (server-only; used by Vite plugin + Vercel /api/v3/report)
# AOI_USERNAME=
# AOI_PASSWORD=
# Show company names on /v3 (default redacted)
# VITE_FEATURE_NAMED_EMPLOYERS=false

# --- Cron ---
# openssl rand -hex 32
CRON_SECRET=

# Optional Gemini personalization (weekly updates + Game Plan analysis)
# Without GEMINI_API_KEY, weekly updates use rotating templates; Game Plan uses deterministic fallback.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
