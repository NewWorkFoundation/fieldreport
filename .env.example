# dear[CC] Field Report + The Letter (Vercel)
# Copy to .env.local for local dev. Set the same keys in the Vercel project.
# Never commit real secrets.

# --- Database (Neon Postgres, pooled URL) ---
DATABASE_URL=

# Unpooled URL for migrations (optional; defaults to DATABASE_URL with -pooler stripped)
# DIRECT_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="dear[CC] The Letter <onboarding@resend.dev>"
# RESEND_REPLY_TO_EMAIL=

# Public site URL for unsubscribe links (Vercel production URL or custom domain)
BASE_URL=http://localhost:5173

# The Letter (Results email CTA posts to ${VITE_LETTER_URL}/api/subscribe)
VITE_LETTER_URL=https://theletter.dearcc.org

# Field Report v3 — AOI employer layer (server-only; used by Vite plugin + Vercel /api/v3/report)
# AOI_USERNAME=
# AOI_PASSWORD=
# Show company names on /v3 (default redacted)
# VITE_FEATURE_NAMED_EMPLOYERS=false

# --- Cron ---
# openssl rand -hex 32
CRON_SECRET=

# Optional Gemini personalization (Letter + Game Plan analysis)
# Without GEMINI_API_KEY, Letter uses rotating templates; Game Plan uses deterministic fallback.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
