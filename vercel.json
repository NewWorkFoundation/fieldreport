{
  "functions": {
    "api/subscribe.js": {
      "includeFiles": "server/**"
    },
    "api/email/preview.js": {
      "includeFiles": "server/**"
    },
    "api/email/sent.js": {
      "includeFiles": "server/**"
    },
    "api/v3/report.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/atlas.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/report.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/footprint.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/compare.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/pathways.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/badges.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/versus.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    },
    "api/v4/industries.js": {
      "includeFiles": "{server/**,public/data/majors.json,public/data/occupations.json,public/data/crosswalk.json,public/data/places.json,public/data/v3/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/search-pages/home.html"
    },
    {
      "source": "/v2",
      "destination": "/search-pages/home.html"
    },
    {
      "source": "/v3",
      "destination": "/search-pages/home.html"
    },
    {
      "source": "/receipts",
      "destination": "/search-pages/receipts.html"
    },
    {
      "source": "/v2/receipts",
      "destination": "/search-pages/receipts.html"
    },
    {
      "source": "/v3/receipts",
      "destination": "/search-pages/receipts.html"
    },
    {
      "source": "/graphic",
      "destination": "/search-pages/graphic.html"
    },
    {
      "source": "/v3/roles",
      "destination": "/search-pages/roles.html"
    },
    {
      "source": "/((?!api(?:/|$)|robots\\.txt$|sitemap\\.xml$|search-pages/|assets/|brand/|data/|.*\\.(?:html|xml|txt|json|js|css|png|jpe?g|webp|svg|ico|woff2?)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/us-states-topo.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/dev/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/v4/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/v2/results/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/v3/results/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/v3/roles/report",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "staging": false
    }
  }
}
